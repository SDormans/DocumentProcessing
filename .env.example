POSTGRES_DB=documentprocessing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-unique-postgres-admin-password
APP_DB_USER=documentprocessing_app
APP_DB_PASSWORD=replace-with-a-unique-application-password
POSTGRES_PORT=5432
API_PORT=8080
WEB_PORT=8081
MAX_FILE_SIZE_BYTES=10485760
DEMO_ADMIN_USERNAME=demo-admin
DEMO_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
DEMO_ADMIN_EMAIL=demo-admin@example.invalid
# AI extraction used by the worker: Fake (deterministic, no key) or OpenAI (OpenAI-compatible endpoint).
AI_PROVIDER=Fake
AI_ENDPOINT=https://api.openai.com/v1/
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Local model (Ollama, llama.cpp). AI_LOCAL_PROVIDER=None hides the option; OpenAI enables any OpenAI-compatible server.
AI_LOCAL_PROVIDER=None
AI_LOCAL_ENDPOINT=http://ollama:11434/v1/
AI_LOCAL_MODEL=llama3.1:8b
# Local CPU models are slow; raise these if extractions time out (keep them under the worker's 5-minute queue lease).
AI_LOCAL_ATTEMPT_TIMEOUT_SECONDS=60
AI_LOCAL_TOTAL_TIMEOUT_SECONDS=180
# Model file in ./models served by llama.cpp (docker compose --profile llamacpp up -d). See models/README.md.
# Use with AI_LOCAL_ENDPOINT=http://llamacpp:8080/v1/ and any AI_LOCAL_MODEL name (the server answers to it).
LLAMA_MODEL_FILE=
LLAMA_CTX_SIZE=8192
LLAMACPP_PORT=8082
# Cloud or Local, for users who have not chosen. Fallback: None (default) or Automatic (may send local documents to the cloud).
AI_DEFAULT_MODEL_TYPE=Cloud
AI_FALLBACK_MODE=None
# Document storage shared by API and worker: Local (Docker volume) or AzureBlob.
# AzureBlob needs either a connection string (e.g. Azurite) or a service URI used with managed identity / DefaultAzureCredential.
FILE_STORAGE_PROVIDER=Local
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_SERVICE_URI=
AZURE_BLOB_MANAGED_IDENTITY_CLIENT_ID=
AZURE_BLOB_CONTAINER=documents
AZURE_BLOB_CREATE_CONTAINER=false
# Console log format: json or simple (default: simple in Development, json otherwise).
LOG_FORMAT=
# OTLP collector for traces, metrics and logs (e.g. http://otel-collector:4317). Empty disables export.
OTEL_EXPORTER_OTLP_ENDPOINT=
